rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSpaceMember(spaceId) {
      return isSignedIn() &&
        (exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) ||
         request.auth.uid in resource.data.memberIds);
    }

    function isValidId(id) {
      return id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    // Handles Collection (Atomic unique reservation)
    match /handles/{handle} {
      allow read: if true;
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/handles/$(handle)) &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // User Public Profiles
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isUser(uid);
      allow delete: if false;
    }

    // Private User Accounts & Proposals
    match /users/{uid} {
      allow read, write: if isUser(uid);

      // Non-authoritative Proposals subcollection: owner read only, no client writes
      match /proposals/{proposalId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // Push Devices
    match /devices/{deviceId} {
      allow read, write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Spaces
    match /spaces/{spaceId} {
      // Supports direct read by member and queries with memberIds array-contains
      allow read: if isSignedIn() &&
        (request.auth.uid in resource.data.memberIds ||
         exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)));
      // No client writes to space doc (all mutations through transactional callables)
      allow write: if false;

      // Members subcollection
      match /members/{memberUid} {
        allow read: if isSpaceMember(spaceId);
        // Members can update ONLY their own lastReadAt timestamp; all other changes via callables
        allow update: if isUser(memberUid) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt']) &&
                         request.resource.data.lastReadAt == request.time;
        allow create, delete: if false;
      }

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSpaceMember(spaceId);

        // Client create: member, kind=='text', exact allowed keys, non-blank <=4000 chars, server ts
        allow create: if isSpaceMember(spaceId) &&
                         isValidId(messageId) &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.kind == 'text' &&
                         request.resource.data.keys().hasOnly(['senderId', 'kind', 'text', 'createdAt', 'replyToId']) &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 4000 &&
                         request.resource.data.createdAt == request.time &&
                         (!('replyToId' in request.resource.data) ||
                          (request.resource.data.replyToId is string &&
                           isValidId(request.resource.data.replyToId) &&
                           exists(/databases/$(database)/documents/spaces/$(spaceId)/messages/$(request.resource.data.replyToId))));

        // Client update: by sender on non-deleted message only
        // 1. EDIT: within 15 minutes, text + editedAt only
        // 2. TOMBSTONE: text == '', deletedAt only
        // 3. Author AI withhold shield toggle
        allow update: if isSpaceMember(spaceId) &&
                         resource.data.senderId == request.auth.uid &&
                         resource.data.deletedAt == null &&
                         (
                           // 15-minute edit window
                           (request.time < resource.data.createdAt + duration.value(15, 'm') &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
                            request.resource.data.text is string &&
                            request.resource.data.text.size() > 0 &&
                            request.resource.data.text.size() <= 4000 &&
                            request.resource.data.editedAt == request.time)
                           ||
                           // Tombstone delete
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deletedAt']) &&
                            request.resource.data.text == '' &&
                            request.resource.data.deletedAt == request.time)
                           ||
                           // Author AI withhold toggle
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiWithheld']))
                         );

        allow delete: if false; // No hard deletes
      }

      // Items subcollection (Board tasks, decisions, questions)
      match /items/{itemId} {
        allow read: if isSpaceMember(spaceId);
        allow write: if false; // Server-written via callables only
      }

      // Handoffs subcollection (Explicit human handoff audit trail)
      match /handoffs/{handoffId} {
        allow read: if isSpaceMember(spaceId);
        allow write: if false; // Immutable audit log written by callables
      }
    }

    // Root Proposals Collection (backward compatibility)
    match /proposals/{proposalId} {
      allow read: if isSignedIn() &&
        (resource.data.createdForUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    // AI Outputs (Audit logs)
    match /aiOutputs/{handoffId} {
      allow read: if isSignedIn();
      allow write: if false; // Server-only
    }

    // Invites & RateLimits: Server-only
    match /invites/{code} {
      allow read, write: if false;
    }
    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}
